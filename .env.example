# ---------------------------------------------------------------------------
# Firebreak configuration
# Copy to `.env` and fill in. Every var below is validated at boot (src/config).
# ---------------------------------------------------------------------------

# --- Slack -----------------------------------------------------------------
# Create an app at https://api.slack.com/apps -> enable Socket Mode.
# Bot token scopes: channels:manage, channels:read, chat:write, commands,
#                   groups:write, users:read, bookmarks:write
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
# App-level token with connections:write (required for Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token
# Channel where incident announcements are broadcast (ID, not name)
SLACK_ANNOUNCE_CHANNEL=C0123456789

# --- GitHub ----------------------------------------------------------------
# Fine-grained PAT with: Contents (read), Pull requests (read),
# Deployments (read), Issues (read & write)
GITHUB_TOKEN=ghp_your_token
GITHUB_OWNER=your-org
GITHUB_REPO=your-service
# Optional: GitHub Enterprise Server API root
# GITHUB_API_URL=https://github.example.com/api/v3

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-5

# --- Runtime ---------------------------------------------------------------
DATABASE_PATH=./data/firebreak.db
LOG_LEVEL=info
PORT=3000

# How far back to look for "recent changes" when an incident is declared.
CHANGE_LOOKBACK_HOURS=48
CHANGE_LOOKBACK_LIMIT=30
