{
  "name": "firebreak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An agentic incident-response bot for Slack: declare incidents, correlate recent deploys, and draft postmortems.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:start": "node dist/mcp/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@octokit/rest": "^22.0.0",
    "@slack/bolt": "^4.4.0",
    "dotenv": "^17.2.3",
    "pino": "^9.13.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^3.2.4"
  }
}
